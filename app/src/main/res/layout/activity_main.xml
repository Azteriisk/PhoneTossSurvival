<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- HORIZONTAL SWIPE VIEWPAGER FOR INFINITE CAROUSEL PAGES -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- INCONSPICUOUS 3-DOT CAROUSEL INDICATOR BAR -->
    <LinearLayout
        android:id="@+id/layoutDotIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/game_title"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Left Dot (Dimmed Dark Circle - Swipe Left Hint) -->
        <View
            android:id="@+id/dotLeft"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_dot_dimmed" />

        <!-- Center Dot (Glowing Active Circle - Current Page) -->
        <View
            android:id="@+id/dotCenter"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_dot_glowing" />

        <!-- Right Dot (Dimmed Dark Circle - Swipe Right Hint) -->
        <View
            android:id="@+id/dotRight"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_dot_dimmed" />

    </LinearLayout>

</LinearLayout>
